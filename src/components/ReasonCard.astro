---
interface Props {
  number: string;
  title: string;
  description: string;
  class?: string;
}

const { number, title, description, class: className = '' } = Astro.props;
---

<div class={`c-reason-card ${className}`}>
  <div class="c-reason-card__header">
    <p class="c-reason-card__number">
      <span class="c-reason-card__number-label">Reason</span>
      <span class="c-reason-card__number-value">{number}</span>
    </p>
    <h3 class="c-reason-card__title" set:html={title} />
  </div>
  <p class="c-reason-card__description">{description}</p>
</div>
