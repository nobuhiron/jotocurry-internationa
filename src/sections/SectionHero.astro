---
import Button from '../components/Button.astro';
import { getImage } from 'astro:assets';
import heroImageWide from '../assets/images/hero-img-wide.jpg';
import heroImageTall from '../assets/images/hero-img-tall.jpg';
import { getTranslation } from '../data/translations';
import { getLocalizedPath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'ja' } = Astro.props;
const heroText = getTranslation('hero', locale);

// PC/スマホで構図の異なる事前クロップ済み画像を出し分ける（クロップは scripts/generate-hero-crops.mjs で生成）
const heroWide = await getImage({ src: heroImageWide, format: 'webp', widths: [1280, 1920, 2880] });
const heroTall = await getImage({ src: heroImageTall, format: 'webp', widths: [585, 780, 1170] });
---

<section class="p-hero" id="section-hero">
  <div class="p-hero__image">
          <picture>
          <source media="(min-width: 768px)" srcset={heroWide.srcSet.attribute} sizes="100vw" />
          <img
            src={heroTall.src}
            srcset={heroTall.srcSet.attribute}
            sizes="100vw"
            alt={locale === 'en' ? "Joto Curry's signature sweet-and-spicy katsu curry topped with a raw egg yolk" : '上等カレーの看板メニュー、生卵をのせた甘辛カツカレー'}
            width={1170}
            height={1517}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      <div class="p-hero__overlay"></div>
  </div>
    <div class="p-hero__content">
      <header class="p-hero__header">
      <div class="p-hero__badge">{heroText.badge}</div>
      <h1 class="p-hero__title" set:html={heroText.title} />
      </header>
      <ul class="p-hero__features">
        {heroText.features.map((feature) => (
          <li class="p-hero__feature">{feature}</li>
        ))}
      </ul>
    </div>
    <div class="p-hero__bottom-section">
      <div class="p-hero__buttons p-hero__buttons--desktop">
        <Button
          text={heroText.buttons.primary}
          variant="primary"
          class="p-hero__button"
          href={getLocalizedPath('/contact#section-contact-form', locale)}
        />
        <!-- <Button
          text={heroText.buttons.secondary}
          variant="secondary"
          icon="↓"
          class="p-hero__button"
        /> -->
      </div>
  </div>
</section>

<script>
  // URLバーの開閉などでビューポート高が変わると、min-heightがsvh基準のため
  // object-fit:coverの画像が拡大縮小して見える環境がある（特にアプリ内ブラウザ）。
  // 初回表示時の高さをpxで固定してこれを防ぐ。横幅が変わったとき（回転・リサイズ）だけ再計算する。
  const heroImage = document.querySelector('.p-hero__image');
  if (heroImage instanceof HTMLElement) {
    let lastWidth = window.innerWidth;
    const lockHeight = () => {
      // 一旦解除してCSS由来の高さを測り直してから固定する
      heroImage.style.minHeight = '';
      heroImage.style.minHeight = `${Math.round(heroImage.getBoundingClientRect().height)}px`;
    };
    lockHeight();
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      lockHeight();
    });
  }
</script>

