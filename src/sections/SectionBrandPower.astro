---
import SectionTitle from '../components/SectionTitle.astro';
import StatCard from '../components/StatCard.astro';
import Button from '../components/Button.astro';
import Image from 'astro/components/Image.astro';
import placeholderImage from '../assets/images/Placeholder Image.jpg';
import { getBrandPowerImages } from '../lib/microcms-brand-power-images';
import { optimizeImageUrl } from '../lib/microcms';
import { getStats } from '../lib/microcms-stats';
import { getTranslation } from '../data/translations';
import { getLocalizedPath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'ja' } = Astro.props;
const brandPowerText = getTranslation('brandPower', locale);
const slideAlt = locale === 'en' ? 'Store noren' : '店舗のれん';

// 統計情報を取得（フォールバック値あり）
let mealsValue = 5000; // デフォルト値（翻訳データの値）
let domesticStoreCount = 44; // デフォルト値
let overseasStoreCount = 11; // デフォルト値

try {
  const stats = await getStats();
  mealsValue = stats.mealsValue;
  domesticStoreCount = stats.domesticStoreCount;
  overseasStoreCount = stats.overseasStoreCount;
} catch (error) {
  console.warn('microCMSから統計情報を取得できませんでした。デフォルト値を使用します。', error);
}

// ブランドパワー画像を取得（フォールバック値あり）
let brandPowerImages: Array<{ url: string; width: number; height: number }> = [];
let isPlaceholderFallback = false;
try {
  const imagesData = await getBrandPowerImages();
  brandPowerImages = imagesData.map((item) => item.image);
} catch (error) {
  console.warn('microCMSからブランドパワー画像を取得できませんでした。フォールバック画像を使用します。', error);
  isPlaceholderFallback = true;
  brandPowerImages = Array.from({ length: 6 }, () => ({
    url: placeholderImage.src,
    width: placeholderImage.width,
    height: placeholderImage.height,
  }));
}
---

<section class="p-brand-power l-section" data-bg="white" id="section-brand-power">
  <div class="l-container">
    <div class="p-brand-power__inner l-section__inner">
      <SectionTitle
        title={brandPowerText.title}
        class="p-brand-power__title"
        align="center"
      />
      <div class="p-brand-power__stats">
        <StatCard
          value={mealsValue.toLocaleString('en-US')}
          unit={brandPowerText.stats.meals.unit}
          label={brandPowerText.stats.meals.label}
          class="p-brand-power__stat"
        />
        <StatCard
          value={String(domesticStoreCount)}
          unit={brandPowerText.stats.domesticStores.unit}
          label={brandPowerText.stats.domesticStores.label}
          class="p-brand-power__stat"
        />
        <StatCard
          value={String(overseasStoreCount)}
          unit={brandPowerText.stats.overseasStores.unit}
          label={brandPowerText.stats.overseasStores.label}
          class="p-brand-power__stat"
        />
      </div>
    </div>
  </div>
  <div class="p-brand-power__carousel-wrapper">
    <div class="p-brand-power__carousel splide" id="brand-power-carousel" aria-label={locale === 'en' ? 'Store photos' : '店舗写真'} aria-roledescription={locale === 'en' ? 'carousel' : 'カルーセル'}>
      <div class="splide__track">
        <ul class="splide__list">
          {brandPowerImages.map((image) => (
            <li class="splide__slide">
              <div class="p-brand-power__slide">
                {isPlaceholderFallback ? (
                  <Image
                    src={placeholderImage}
                    alt={slideAlt}
                    width={image.width}
                    height={image.height}
                    format="webp"
                    loading="lazy"
                    class="p-brand-power__slide-image"
                  />
                ) : (
                  <img
                    src={optimizeImageUrl(image.url, 800)}
                    srcset={`${optimizeImageUrl(image.url, 400)} 400w, ${optimizeImageUrl(image.url, 600)} 600w, ${optimizeImageUrl(image.url, 800)} 800w`}
                    sizes="(min-width: 1024px) 400px, 100vw"
                    alt={slideAlt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    class="p-brand-power__slide-image"
                  />
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <div class="l-container">
    <div class="p-brand-power__button-wrapper">
      <Button
        href={getLocalizedPath(brandPowerText.buttonLink, locale)}
        text={brandPowerText.button}
        variant="secondary"
        icon="→"
        class="p-brand-power__button"
      />
    </div>
  </div>
</section>

<script>
  import initBrandPower from '../scripts/brand-power.js';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBrandPower);
  } else {
    initBrandPower();
  }
</script>
